<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Melit Trade Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container-fluid">
      <a class="navbar-brand" href="/admin/dashboard"><i class="fas fa-cogs me-2"></i>Melit Trade CMS</a>
      <div class="navbar-nav ms-auto">
        <span class="navbar-text me-3"><i class="fas fa-user me-2"></i>Welcome, <%= user.username %></span>
        <button class="btn btn-outline-light" onclick="logout()"><i class="fas fa-sign-out-alt me-2"></i>Logout</button>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 bg-white rounded-3 shadow-sm">
      <div>
        <h2 class="mb-1"><i class="fas fa-comments me-2"></i>Manage Testimonials</h2>
        <p class="text-muted mb-0">Add, edit, and manage customer testimonials</p>
      </div>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#testimonialModal"><i class="fas fa-plus me-2"></i>Add Testimonial</button>
    </div>

    <div class="row">
      <% testimonials.forEach(t => { %>
        <div class="col-md-6">
          <div class="card shadow-sm mb-4">
            <div class="card-body">
              <blockquote class="blockquote mb-3">
                <p class="mb-0">“<%= t.text %>”</p>
              </blockquote>
              <footer class="blockquote-footer">
                <strong><%= t.author %></strong> <span class="text-muted">— <%= t.profession %></span>
              </footer>
              <div class="mt-3">
                <button class="btn btn-outline-primary btn-sm" onclick="editTestimonial('<%= t.id %>', `<%= t.text.replace(/`/g, '\\`') %>`, '<%= t.author %>', '<%= t.profession %>')"><i class="fas fa-edit"></i></button>
                <button class="btn btn-outline-danger btn-sm" onclick="deleteTestimonial('<%= t.id %>')"><i class="fas fa-trash"></i></button>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (testimonials.length === 0) { %>
      <div class="text-center py-5">
        <i class="fas fa-comments fa-3x text-muted mb-3"></i>
        <h4 class="text-muted">No testimonials yet</h4>
        <p class="text-muted">Add your first testimonial</p>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#testimonialModal"><i class="fas fa-plus me-2"></i>Add Testimonial</button>
      </div>
    <% } %>
  </div>

  <!-- Add/Edit Testimonial Modal -->
  <div class="modal fade" id="testimonialModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
          <h5 class="modal-title" id="testimonialModalTitle"><i class="fas fa-plus me-2"></i>Add Testimonial</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <form id="testimonialForm">
          <div class="modal-body">
            <input type="hidden" id="tid" name="id">
            <div class="mb-3">
              <label for="ttext" class="form-label">Testimonial Text</label>
              <textarea class="form-control" id="ttext" name="text" rows="4" required></textarea>
            </div>
            <div class="mb-3">
              <label for="tauthor" class="form-label">Author</label>
              <input type="text" class="form-control" id="tauthor" name="author" required>
            </div>
            <div class="mb-3">
              <label for="tprofession" class="form-label">Profession</label>
              <input type="text" class="form-control" id="tprofession" name="profession" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let editing = false; let currentId = null;

    document.getElementById('testimonialForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const btn = form.querySelector('button[type="submit"]');
      const orig = btn.innerHTML;
      const data = { text: form.text.value, author: form.author.value, profession: form.profession.value };
      try {
        btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving...';
        const url = editing ? `/admin/testimonials/${currentId}` : '/admin/testimonials';
        const method = editing ? 'PUT' : 'POST';
        const resp = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        const result = await resp.json();
        if (result.success) location.reload(); else alert(result.error || 'Operation failed');
      } catch(err) { alert('Network error'); }
      finally { btn.disabled = false; btn.innerHTML = orig; }
    });

    function editTestimonial(id, text, author, profession) {
      editing = true; currentId = id;
      document.getElementById('testimonialModalTitle').innerHTML = '<i class="fas fa-edit me-2"></i>Edit Testimonial';
      document.getElementById('tid').value = id;
      document.getElementById('ttext').value = text;
      document.getElementById('tauthor').value = author;
      document.getElementById('tprofession').value = profession;
      new bootstrap.Modal(document.getElementById('testimonialModal')).show();
    }

    async function deleteTestimonial(id) {
      if (!confirm('Delete this testimonial?')) return;
      const resp = await fetch(`/admin/testimonials/${id}`, { method: 'DELETE' });
      const result = await resp.json();
      if (result.success) location.reload(); else alert(result.error || 'Delete failed');
    }

    document.getElementById('testimonialModal').addEventListener('hidden.bs.modal', () => {
      editing = false; currentId = null;
      document.getElementById('testimonialForm').reset();
      document.getElementById('testimonialModalTitle').innerHTML = '<i class=\"fas fa-plus me-2\"></i>Add Testimonial';
    });

    async function logout() {
      const resp = await fetch('/admin/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      const result = await resp.json(); if (result.success) window.location.href = result.redirect;
    }
  </script>
</body>
</html>


