<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Melit Trade Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container-fluid">
      <a class="navbar-brand" href="/admin/dashboard"><i class="fas fa-cogs me-2"></i>Melit Trade CMS</a>
      <div class="navbar-nav ms-auto">
        <span class="navbar-text me-3"><i class="fas fa-user me-2"></i>Welcome, <%= user.username %></span>
        <button class="btn btn-outline-light" onclick="logout()"><i class="fas fa-sign-out-alt me-2"></i>Logout</button>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 bg-white rounded-3 shadow-sm">
      <div>
        <h2 class="mb-1"><i class="fas fa-tags me-2"></i>Manage Deals</h2>
        <p class="text-muted mb-0">Create, edit, and manage weekly deals</p>
      </div>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#dealModal"><i class="fas fa-plus me-2"></i>Create Deal</button>
    </div>

    <div class="row">
      <% deals.forEach(d => { %>
        <div class="col-md-6">
          <div class="card shadow-sm mb-4">
            <div class="row g-0">
              <div class="col-4">
                <img src="<%= d.imgSrc %>" class="img-fluid rounded-start" alt="<%= d.title %>" style="height: 100%; object-fit: cover;">
              </div>
              <div class="col-8">
                <div class="card-body">
                  <h5 class="card-title mb-1"><%= d.title %></h5>
                  <p class="text-muted mb-2"><%= d.category %> • <strong><%= d.price %></strong></p>
                  <p class="card-text"><%= d.description %></p>
                  <p class="card-text"><small class="text-muted">Target Date: <%= d.targetDate %></small></p>
                  <div class="d-flex align-items-center gap-2">
                    <div class="form-check form-switch">
                      <input class="form-check-input" type="checkbox" role="switch" id="active_<%= d.id %>" <%= d.active ? 'checked' : '' %> onchange="toggleActive('<%= d.id %>', this.checked)">
                      <label class="form-check-label" for="active_<%= d.id %>"><%= d.active ? 'Active' : 'Inactive' %></label>
                    </div>
                    <button class="btn btn-outline-primary btn-sm" onclick="editDeal('<%= d.id %>')"><i class="fas fa-edit"></i></button>
                    <button class="btn btn-outline-danger btn-sm" onclick="deleteDeal('<%= d.id %>')"><i class="fas fa-trash"></i></button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (deals.length === 0) { %>
      <div class="text-center py-5">
        <i class="fas fa-tags fa-3x text-muted mb-3"></i>
        <h4 class="text-muted">No deals yet</h4>
        <p class="text-muted">Create your first deal</p>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#dealModal"><i class="fas fa-plus me-2"></i>Create Deal</button>
      </div>
    <% } %>
  </div>

  <!-- Add/Edit Deal Modal -->
  <div class="modal fade" id="dealModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
          <h5 class="modal-title" id="dealModalTitle"><i class="fas fa-plus me-2"></i>Create Deal</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <form id="dealForm" enctype="multipart/form-data">
          <div class="modal-body">
            <input type="hidden" id="did" name="id">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Title</label>
                <input class="form-control" name="title" id="dtitle" required>
              </div>
              <div class="col-md-3">
                <label class="form-label">Price</label>
                <input class="form-control" name="price" id="dprice" required>
              </div>
              <div class="col-md-3">
                <label class="form-label">Category</label>
                <input class="form-control" name="category" id="dcategory" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Target Date</label>
                <input type="date" class="form-control" name="targetDate" id="dtargetDate" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Image</label>
                <input type="file" class="form-control" name="image" id="dimage" accept="image/*">
                <small class="text-muted">Leave empty to keep current image when editing</small>
              </div>
              <div class="col-12">
                <label class="form-label">Description</label>
                <textarea class="form-control" rows="4" name="description" id="ddescription" required></textarea>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let editing = false; let currentId = null;

    document.getElementById('dealForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const btn = e.target.querySelector('button[type="submit"]');
      const orig = btn.innerHTML;
      try {
        btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving...';
        const url = editing ? `/admin/deals/${currentId}` : '/admin/deals';
        const method = editing ? 'PUT' : 'POST';
        const resp = await fetch(url, { method, body: formData });
        const result = await resp.json();
        if (result.success) location.reload(); else alert(result.error || 'Operation failed');
      } catch(err) { alert('Network error'); }
      finally { btn.disabled = false; btn.innerHTML = orig; }
    });

    function editDeal(id) {
      const card = document.getElementById('active_' + id).closest('.card');
      const title = card.querySelector('.card-title').innerText;
      const meta = card.querySelector('.text-muted').innerText; // category • price
      const [category, priceLabel] = meta.split(' • ');
      const price = priceLabel;
      const desc = card.querySelector('.card-text').innerText;
      const tdate = card.querySelector('small').innerText.replace('Target Date: ', '').trim();

      editing = true; currentId = id;
      document.getElementById('dealModalTitle').innerHTML = '<i class="fas fa-edit me-2"></i>Edit Deal';
      document.getElementById('did').value = id;
      document.getElementById('dtitle').value = title;
      document.getElementById('dprice').value = price;
      document.getElementById('dcategory').value = category;
      document.getElementById('ddescription').value = desc;
      document.getElementById('dtargetDate').value = tdate;
      new bootstrap.Modal(document.getElementById('dealModal')).show();
    }

    async function deleteDeal(id) {
      if (!confirm('Delete this deal?')) return;
      const resp = await fetch(`/admin/deals/${id}`, { method: 'DELETE' });
      const result = await resp.json();
      if (result.success) location.reload(); else alert(result.error || 'Delete failed');
    }

    async function toggleActive(id, active) {
      const formData = new FormData();
      formData.append('active', String(active));
      const resp = await fetch(`/admin/deals/${id}`, { method: 'PUT', body: formData });
      const result = await resp.json();
      if (!result.success) alert(result.error || 'Failed to update'); else location.reload();
    }

    document.getElementById('dealModal').addEventListener('hidden.bs.modal', () => {
      editing = false; currentId = null;
      document.getElementById('dealForm').reset();
      document.getElementById('dealModalTitle').innerHTML = '<i class="fas fa-plus me-2"></i>Create Deal';
    });

    async function logout() {
      const resp = await fetch('/admin/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      const result = await resp.json(); if (result.success) window.location.href = result.redirect;
    }
  </script>
</body>
</html>


